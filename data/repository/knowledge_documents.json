  "FMEA-AIR-001@1.0": {
    "id": "FMEA-AIR-001",
    "type": "FMEA",
    "title": "空压机过滤器压差升高",
    "failure_mode": "filter_restriction",
    "content": "过滤器堵塞会造成吸气阻力增加、压差升高、排气温度升高，并可能导致单位产量能耗恶化。",
    "action": "检查过滤器压差并按维护标准更换滤芯。",
    "tags": [
      "filter_restriction",
      "filter",
      "pressure",
      "energy"
    ],
