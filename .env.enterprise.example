PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://industrial_semantic:industrial_semantic@postgres:5432/industrial_semantic
EXECUTION_MODE=mock
# Doris production example:
# EXECUTION_MODE=doris
# DORIS_HOST=127.0.0.1
# DORIS_PORT=9030
# DORIS_USER=root
# DORIS_PASSWORD_REF=secret://env/DORIS_PASSWORD
# DORIS_PASSWORD=  # legacy only
# DORIS_DATABASE=industrial_ai

# V1.1 knowledge retrieval: local | qdrant | pgvector
KNOWLEDGE_BACKEND=local
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=industrial_knowledge
QDRANT_API_KEY_REF=secret://env/QDRANT_API_KEY
QDRANT_API_KEY=

# Enterprise tenancy
DEFAULT_TENANT_ID=default

# V2.6 authentication: disabled | dev | jwt | oidc
AUTH_MODE=disabled
AUTH_AUTO_PROVISION=false
# OIDC / Keycloak / Microsoft Entra ID issuer, e.g. https://login.microsoftonline.com/<tenant>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# Claim mapping
AUTH_PRINCIPAL_CLAIM=sub
AUTH_TENANT_CLAIM=tenant_id
AUTH_ORG_CLAIM=org_id
AUTH_ROLES_CLAIM=roles
AUTH_SITES_CLAIM=site_ids
AUTH_ASSETS_CLAIM=asset_ids
AUTH_CONNECTORS_CLAIM=connector_ids
# jwt mode shared secret (prefer OIDC for production)
AUTH_JWT_SECRET=
# dev mode only; never use the default in production
AUTH_DEV_SECRET=change-me-dev-secret

# V2.7 Secret providers. Prefer references over inline credentials.
SECRETS_DEFAULT_PROVIDER=env
SECRETS_FILE_ROOT=/run/secrets
# Examples:
# DORIS_PASSWORD_REF=secret://env/DORIS_PASSWORD
# QDRANT_API_KEY_REF=secret://file/qdrant_api_key
# AUTH_JWT_SECRET_REF=secret://file/auth_jwt_secret
# VAULT_ADDR=https://vault.example.com
# VAULT_KV_MOUNT=secret
# AZURE_KEY_VAULT_URL=https://example.vault.azure.net

# V3.0 production lifecycle
DEPLOYMENT_ENV=development
AUTO_MIGRATE=true
# Set DEPLOYMENT_ENV=production only after configuring PostgreSQL + auth + real execution backends.

# V3.2 Docker Compose build/runtime switches
# Default Compose = PostgreSQL + mock execution + local knowledge.
# To enable Qdrant, also build the qdrant extra and start the qdrant profile:
# INSTALL_EXTRAS=postgres,governance,auth,qdrant
# KNOWLEDGE_BACKEND=qdrant
# To connect real Doris:
# EXECUTION_MODE=doris
# DORIS_HOST=doris.example.internal
# DORIS_PASSWORD_REF=secret://env/DORIS_PASSWORD

# V4.8 SaaS API Pull 安全策略：默认禁止私网/明文 HTTP；企业内网请使用 Edge Agent 主动出站。
ALLOW_PRIVATE_API_PULL=false
ALLOW_INSECURE_API_HTTP=false
